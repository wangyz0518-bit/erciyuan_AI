# macOS/Linux: export these in a local shell. Never put provider keys in Flutter.
GATEWAY_MODE=live
GATEWAY_TOKEN=replace-with-random-development-token-at-least-24-characters
GATEWAY_DATA_DIR=../../.model-local/gateway-live
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
COSYVOICE_VOICE_ID=
# Optional per-character voice; falls back to the development voice above.
COSYVOICE_YUE_VOICE_ID=
